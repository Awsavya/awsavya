# Contact form delivery (Resend)
# Create an API key at https://resend.com and verify the sender domain before going live.
RESEND_API_KEY=re_your_api_key_here
CONTACT_TO_EMAIL=your-inbox@example.com
CONTACT_FROM_EMAIL=AWSAVYA Website <website@your-verified-domain.com>

# Optional canonical website URL; used for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://awsavya.in
