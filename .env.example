# ==============================================================================
# AWSAVYA Website Environment Configuration (Template)
# Copy this file to .env.local for local development. Never commit real keys.
# ==============================================================================

# Contact form email delivery via Resend (https://resend.com)
# Obtain an API key from your Resend dashboard:
RESEND_API_KEY=re_your_api_key_here

# The destination inbox where client project enquiries are delivered:
CONTACT_TO_EMAIL=hello@awsavya.in

# The verified sender address configured and verified in your Resend domain settings:
# Must use a verified domain (e.g. awsavya.in) rather than an unverified public mailbox.
CONTACT_FROM_EMAIL=AWSAVYA Enquiries <enquiries@awsavya.in>

# Canonical website URL (used for canonical links, sitemap, and Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://www.awsavya.in
