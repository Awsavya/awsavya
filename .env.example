# ==============================================================================
# AWSAVYA Website Environment Configuration (Template)
# Copy this file to .env.local for local development. Never commit real keys.
# ==============================================================================

# Contact form email delivery via Web3Forms (https://web3forms.com)
# Obtain an Access Key from your Web3Forms dashboard / email registration:
WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# Canonical website URL (used for canonical links, sitemap, and Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://www.awsavya.in
